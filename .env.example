# ==============================================================================
# NOVARA COMMERCE — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# MongoDB Atlas Cloud Database Connection String (REQUIRED)
# Format: mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE_NAME?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE_NAME?retryWrites=true&w=majority

# Runtime Environment & Port
NODE_ENV=production
PORT=3000

# Authentication & Security
JWT_SECRET=YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS
ADMIN_EMAIL=admin@novaracommerce.com
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD

# Optional Media & Email Services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=orders@novaracommerce.com